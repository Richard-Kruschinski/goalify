# Copy to .env and adjust. .env is git-ignored.

PROJECT_NAME="Goalify API"
ENVIRONMENT=local              # local | staging | production
DEBUG=true
LOG_LEVEL=INFO

# openssl rand -hex 32
SECRET_KEY=dev-only-secret-change-me-before-any-real-deployment
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=60

# Local default is SQLite; Postgres for staging/production:
# DATABASE_URL=postgresql+asyncpg://goalify:goalify@localhost:5432/goalify
DATABASE_URL=sqlite+aiosqlite:///./goalify.db
DB_ECHO=false

# Comma-separated list. Flutter web dev server / local tooling.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
